generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String?  @default("autopartner2026")
  role        String   @default("KAM") // "SUPER_ADMIN" | "DIRECTEUR" | "MANAGER" | "KAM"
  status      String   @default("ACTIVE") // "ACTIVE" | "DISABLED"
  avatar      String?  @db.LongText
  title       String?  @default("Key Account Manager")
  permissions String?  @default("view_clients,edit_clients,view_ca,add_notes,add_visits")
  managerId   String?
  manager     User?    @relation("ManagerToKams", fields: [managerId], references: [id])
  kams        User[]   @relation("ManagerToKams")
  clients     Client[]
  notes       Note[]
  visits      Visit[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id            String        @id @default(cuid())
  company       String
  contactName   String
  position      String
  email         String
  phone         String
  city          String
  logo          String?       @db.LongText
  status        String        @default("ACTIVE") // "VIP" | "ACTIVE" | "NEW" | "FOLLOW_UP" | "INACTIVE"
  healthScore   Int           @default(85)       // 0 to 100
  lastContactAt DateTime      @default(now())
  kamId         String
  kam           User          @relation(fields: [kamId], references: [id], onDelete: Cascade)
  notes         Note[]
  visits        Visit[]
  photos        ClientPhoto[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ClientPhoto {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label          String?
  category       String   @default("AUTRE") // "FACADE" | "SAS_NUIT" | "CLE_DIGICODE" | "DEPOT_COLIS" | "AUTRE"
  url            String   @db.LongText
  note           String?  @db.Text
  sizeKb         Int?     @default(0)
  originalSizeKb Int?     @default(0)
  format         String?  @default("JPG")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  title     String?
  content   String   @db.LongText
  category  String   @default("LIBRE") // "LIBRE" | "COMPTE_RENDU" | "RELANCE" | "STRATEGIE" | "ALERTE" | "IDEE"
  pinned    Boolean  @default(false)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  kamId     String
  kam       User     @relation(fields: [kamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitId   String?
  visit     Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
}

model Visit {
  id            String    @id @default(cuid())
  date          String    // YYYY-MM-DD
  time          String?   // HH:mm
  type          String    @default("ROUTINE")
  status        String    @default("EFFECTUEE")
  interlocutor  String?
  summary       String    @db.LongText
  nextVisitDate String?
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kamId         String
  kam           User      @relation(fields: [kamId], references: [id], onDelete: Cascade)
  notes         Note[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
